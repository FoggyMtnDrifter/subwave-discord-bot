# ─────────────────────────────────────────────────────────────
#  SUB/WAVE Discord bot — configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values.

# ── Discord (required) ───────────────────────────────────────
# Bot token from https://discord.com/developers/applications → your app → Bot
DISCORD_TOKEN=

# Application (client) ID — same app, "General Information" → Application ID.
# Required to register slash commands.
DISCORD_CLIENT_ID=

# Optional: register commands instantly to ONE test guild instead of globally
# (global commands can take up to ~1h to appear). Leave blank for global.
DISCORD_DEV_GUILD_ID=

# ── SUB/WAVE station (required) ──────────────────────────────
# The public origin of your SUB/WAVE station (no trailing slash).
# e.g. https://radio.example.com
SUBWAVE_BASE_URL=

# Optional: override the audio stream URL. If unset, the bot uses the mount
# reported by /api/now-playing (typically <base>/stream.mp3).
# SUBWAVE_STREAM_URL=https://radio.example.com/stream.mp3

# Optional: station display name shown in embeds / rich presence.
STATION_NAME=SUB/WAVE

# ── Tuning (optional) ────────────────────────────────────────
# How often (ms) to poll now-playing and refresh the bot's rich presence.
PRESENCE_INTERVAL_MS=15000

# How long (ms) to keep polling a submitted request for its outcome.
REQUEST_POLL_TIMEOUT_MS=25000

# Register slash commands automatically on startup, so you don't have to run
# `npm run deploy` separately. The Docker image sets this to true by default.
# AUTO_DEPLOY_COMMANDS=true
